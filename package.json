{
  "name": "netguard",
  "version": "1.0.0",
  "description": "NetGuard Download Manager - based on Quantum Download Manager (MIT)",
  "author": {
    "name": "NetGuard contributors"
  },
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win": "node scripts/fetch-yt-dlp.js && tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "fetch-yt-dlp": "node scripts/fetch-yt-dlp.js",
    "typecheck": "tsc --noEmit",
    "test:extension": "node extension/tests/ng-core.test.js && node extension/tests/background-flow.test.js",
    "validate": "python scripts/validate.py",
    "package:extensions": "python scripts/package_extensions.py",
    "test:ui": "node --experimental-strip-types scripts/ui-logic.test.mts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "lucide-react": "^0.303.0",
    "postcss": "^8.4.32",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10",
    "zustand": "^4.4.7"
  }
}
